---
import Layout from "../layouts/Layout.astro";
import data from "../../public/data.json";
import "../../assets/scss/astro-ecommerce.scss";
import CardProduct from "../components/products/cardProduct";
import CategoryFilters from "../components/products/categoryFilters";
import CardCategory from "../components/products/cardCategory";
import ProductFeature from "../components/products/productFeature";
import Navbar from "../components/navbar";
import Footer from "../components/footer";
import TestimonialsFade from "../components/promo/testimonialsFade";
import PromoSectionLarge from "../components/promo/promoSectionLarge";
---

<Layout title="Carpets">
  <main>
    <Navbar />
    <!-- <PromoSectionLarge
      title={"Carpet"}
      full_description={""}
      pageHeaderBgImg={"../images/carpet/carpet.jpg"}
      pageHeaderMinVh="90vh"
    /> -->
    <div class="container my-5">
      <h3>Carpets</h3>
      <p>Explore our unique collection of carpets.</p>
      <div class="row mt-5">
        {
          data.carpets.map((product) => (
            <div class="col-md-6 col-lg-3">
              <CardProduct
                thumb_src={product.thumb_src}
                thumb_alt={product.thumb_alt}
                color={product.color}
                colors={product.colors}
                title={product.title}
                description={product.description}
                price={product.price}
                position="center"
              />
            </div>
          ))
        }
      </div>

      <!-- <div class="my-10">
        <h3>Category filters</h3>
        <p class="mb-5">With inline actions and expandable sidebar filters</p>
        <CategoryFilters title="Our products" />
      </div> -->
      <!-- <PromoSectionLarge 
      title="Basic Starter Pack"
