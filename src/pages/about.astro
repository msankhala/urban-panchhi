import Navbar from "../components/navbar";
import Footer from "../components/footer";
import TestimonialsFade from "../components/promo/testimonialsFade";
import PromoSectionLarge from "../components/promo/promoSectionLarge";
---

<Layout title="About">
  <main>
    <Navbar />
    <!-- <PromoSectionLarge
      title={"About Us"}
      full_description={""}
